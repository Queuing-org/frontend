{
  "name": "queuing-org",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:https": "mkdir -p certificates && TRUST_STORES=system mkcert -cert-file ./certificates/local-queuing-cc.pem -key-file ./certificates/local-queuing-cc-key.pem local.queuing.cc localhost 127.0.0.1 ::1",
    "dev": "next dev -H local.queuing.cc -p 3000 --experimental-https --experimental-https-key ./certificates/local-queuing-cc-key.pem --experimental-https-cert ./certificates/local-queuing-cc.pem",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@ssgoi/react": "^4.2.1",
    "@stomp/stompjs": "^7.2.1",
    "@tanstack/react-query": "^5.90.12",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.13.2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.14.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-draggable": "^4.5.0",
    "react-error-boundary": "^6.1.2",
    "react-spinners": "^0.17.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^29.1.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
